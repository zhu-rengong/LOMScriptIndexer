{
  "name": "scriptindexer-web",
  "version": "1.19.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "framing": "vite --open /framing/",
    "types": "node scripts/types.mjs",
    "prebuild": "node scripts/types.mjs",
    "build": "node scripts/prune.mjs && vite build && vue-tsc --build",
    "typecheck": "vue-tsc --build",
    "lint": "eslint src vite.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@tanstack/vue-query": "^5.108.0",
    "@tanstack/vue-virtual": "^3.13.52",
    "@vueuse/core": "^15.0.0",
    "@vueuse/integrations": "^15.0.0",
    "fflate": "0.8.3",
    "focus-trap": "^8.2.5",
    "minisearch": "^7.2.0",
    "opencc-js": "^1.4.2",
    "pinia": "^4.1.0",
    "valibot": "^1.5.0",
    "vue": "3.5.46",
    "vue-i18n": "^11.4.23",
    "vue-router": "^4.6.5"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.2.8",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "json-schema-to-typescript": "^16.0.0",
    "prettier": "^3.10.1",
    "sirv": "^3.0.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "pnpm": ">=12.11.2 <13"
  }
}
