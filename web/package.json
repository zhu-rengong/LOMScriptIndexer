{
  "name": "scriptindexer-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "framing": "vite --open /framing/",
    "types": "node scripts/types.mjs",
    "prebuild": "node scripts/types.mjs",
    "build": "node scripts/prune.mjs && vue-tsc --build && vite build",
    "typecheck": "vue-tsc --build",
    "lint": "oxlint src vite.config.ts",
    "format": "oxfmt --write .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@floating-ui/vue": "^2.0.1",
    "opencc-js": "^1.4.2",
    "pinia": "^4.1.0",
    "valibot": "^1.5.0",
    "vue": "3.6.0-rc.14",
    "vue-i18n": "^11.4.18"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "json-schema-to-typescript": "^16.0.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "sirv": "^3.0.2",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.6",
    "vue-tsc": "^3.3.14"
  },
  "packageManager": "pnpm@12.11.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
