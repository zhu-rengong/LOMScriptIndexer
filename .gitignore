# extraction and build intermediates, regenerated by scriptindexer-extract and scriptindexer-build
data/lua/
data/locale/
data/cache/
data/manifest.json
data/report.json
data/checkpoints.json
data/entries.json
data/lore.json
data/stats.json
data/battles.json
data/missions.json

# generated reader data written by scriptindexer-build
docs/data/

# static site produced from web/ by vite, republished by publish-pages.ps1
web/node_modules/
web/node_modules/.tmp/
docs/index.html
docs/assets/
docs/robots.txt
docs/.nojekyll
*.tsbuildinfo

# development screenshots
docs/_shot-*.png
tools/shots/

# python caches and virtual environments
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# local CodeBuddy plan archive, rule files stay tracked
.codebuddy/plans/

# WorkBuddy published-app marker (machine-specific absolute path, stays local);
# .workbuddy/applications.yaml is tracked on purpose for cross-machine deploys
.wbapp_*.genie

# editor and system files
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini
*.log
